# ==========================================================
# DepGuard AI - variáveis de ambiente
# Copie para `.env` (raiz) e ajuste os valores.
# ==========================================================

# ---------- LLM ----------
# Obrigatória para a análise por IA. Sem ela o app funciona 100% nas regras determinísticas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Endpoint alternativo compatível com a API da Anthropic (LM Studio, Ollama,
# llama.cpp, LiteLLM...). Vazio = usa api.anthropic.com.
# De dentro de um container use host.docker.internal, nunca 127.0.0.1.
# LM Studio: http://host.docker.internal:1234
ANTHROPIC_BASE_URL=
# Ajusta o orçamento de tokens por lote (max_tokens enviado ao modelo)
LLM_MAX_TOKENS=8000
# Quantidade de dependências por chamada ao LLM
LLM_BATCH_SIZE=12
LLM_BATCH_CONCURRENCY=2

# ---------- GitHub ----------
# Opcional. Aumenta o rate limit de 60 req/h para 5000 req/h e dá acesso a repositórios privados.
GITHUB_TOKEN=

# ---------- API ----------
# Origens permitidas no CORS, separadas por vírgula. Use "*" para liberar todas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Limite de requisições por IP
RATE_LIMIT_PER_MINUTE=10
# Tamanho máximo do package.json enviado (bytes)
MAX_UPLOAD_BYTES=1048576
# Ambiente: development | production
APP_ENV=development
# Log verboso (nunca loga a chave da API)
LOG_LEVEL=INFO

# ---------- Rede / cache ----------
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
REGISTRY_CACHE_TTL_SECONDS=3600
# Concorrência máxima de chamadas ao registry.npmjs.org
REGISTRY_CONCURRENCY=8
# Concorrência máxima de chamadas ao OSV
OSV_CONCURRENCY=4
# Habilita cache em memória (desligue em deploy com múltiplos workers se quiser)
CACHE_ENABLED=true

# ---------- Frontend (Vite) ----------
# Deixe vazio em dev (usa o proxy do Vite). Em produção use a URL pública do backend.
VITE_API_URL=
