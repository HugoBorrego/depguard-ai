# ---- variáveis do frontend --------------------------------------------------
# URL pública do backend embutida no bundle em produção.
# Deixe VAZIA quando o nginx (mesma imagem) faz o proxy de /api -> backend,
# que é o padrão do docker-compose. Preencha apenas ao hospedar o frontend
# em um domínio separado do backend.
VITE_API_URL=

# Backend usado pelo proxy do Vite em desenvolvimento (npm run dev).
# Só Affecta o ambiente de desenvolvimento, nunca o bundle de produção.
VITE_BACKEND_PROXY_URL=http://127.0.0.1:8000
